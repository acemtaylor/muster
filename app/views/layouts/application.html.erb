<!DOCTYPE html>
<html>
  <head>
    <title>Muster</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
<%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>    <%= javascript_importmap_tags %>
  </head>
  <body class="bg-gray-50 text-gray-900">
    <% if team_member_signed_in? %>
      <div class="min-h-screen flex">
        <aside class="w-56 bg-gray-900 text-white flex-shrink-0">
          <div class="p-4 text-lg font-semibold border-b border-gray-800">
            Muster
          </div>
          <nav class="p-2 space-y-1">
            <%= link_to "Dashboard", root_path, class: "block px-3 py-2 rounded hover:bg-gray-800" %>
            <%= link_to "People", people_path, class: "block px-3 py-2 rounded hover:bg-gray-800" %>
            <%= link_to "Events", events_path, class: "block px-3 py-2 rounded hover:bg-gray-800" %>
          </nav>
          <div class="p-4 border-t border-gray-800 mt-4 text-sm">
            <div class="text-gray-400 mb-2"><%= current_team_member.email %></div>
            <%= button_to "Log out", destroy_team_member_session_path, method: :delete, class: "text-gray-300 hover:text-white" %>
          </div>
        </aside>
        <main class="flex-1 p-8">
          <% if notice %>
            <div class="mb-4 p-3 bg-green-100 text-green-800 rounded"><%= notice %></div>
          <% end %>
          <% if alert %>
            <div class="mb-4 p-3 bg-red-100 text-red-800 rounded"><%= alert %></div>
          <% end %>
          <%= yield %>
        </main>
      </div>
    <% else %>
      <%= yield %>
    <% end %>
  </body>
</html>
