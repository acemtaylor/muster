<h1 class="text-2xl font-bold mb-6">Dashboard</h1>

<div class="grid grid-cols-3 gap-4 mb-8">
  <div class="bg-white p-6 rounded-lg shadow-sm border">
    <div class="text-sm text-gray-500">Total People</div>
    <div class="text-3xl font-bold mt-1"><%= @person_count %></div>
  </div>
  <div class="bg-white p-6 rounded-lg shadow-sm border">
    <div class="text-sm text-gray-500">Active Members</div>
    <div class="text-3xl font-bold mt-1"><%= @active_memberships %></div>
  </div>
  <div class="bg-white p-6 rounded-lg shadow-sm border">
    <div class="text-sm text-gray-500">Upcoming Events</div>
    <div class="text-3xl font-bold mt-1"><%= @upcoming_events.count %></div>
  </div>
</div>

<h2 class="text-lg font-semibold mb-3">Upcoming Events</h2>
<div class="bg-white rounded-lg shadow-sm border divide-y">
  <% @upcoming_events.each do |event| %>
    <div class="p-4">
      <div class="font-medium"><%= event.title %></div>
      <div class="text-sm text-gray-500"><%= event.starts_at.strftime("%b %d, %Y %I:%M %p") %></div>
    </div>
  <% end %>
  <% if @upcoming_events.empty? %>
    <div class="p-4 text-gray-500">No upcoming events.</div>
  <% end %>
</div>
