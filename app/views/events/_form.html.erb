<%= form_with model: @event, class: "bg-white rounded-lg shadow-sm border p-6 space-y-4" do |f| %>
  <% if @event.errors.any? %>
    <div class="bg-red-50 text-red-700 p-3 rounded text-sm">
      <ul class="list-disc list-inside">
        <% @event.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :title, class: "block text-sm text-gray-600 mb-1" %>
    <%= f.text_field :title, class: "w-full border rounded px-3 py-2" %>
  </div>

  <div>
    <%= f.label :description, class: "block text-sm text-gray-600 mb-1" %>
    <%= f.text_area :description, rows: 3, class: "w-full border rounded px-3 py-2" %>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :starts_at, class: "block text-sm text-gray-600 mb-1" %>
      <%= f.datetime_field :starts_at, class: "w-full border rounded px-3 py-2" %>
    </div>
    <div>
      <%= f.label :ends_at, class: "block text-sm text-gray-600 mb-1" %>
      <%= f.datetime_field :ends_at, class: "w-full border rounded px-3 py-2" %>
    </div>
  </div>

  <div>
    <%= f.label :virtual_url, "Virtual meeting link", class: "block text-sm text-gray-600 mb-1" %>
    <%= f.text_field :virtual_url, class: "w-full border rounded px-3 py-2" %>
  </div>

  <div class="pt-2">
    <%= f.submit class: "bg-gray-900 text-white px-4 py-2 rounded hover:bg-gray-800 cursor-pointer" %>
  </div>
<% end %>
