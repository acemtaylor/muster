<div class="flex justify-between items-center mb-6">
  <h1 class="text-2xl font-bold">Events</h1>
  <%= link_to "Add Event", new_event_path, class: "bg-gray-900 text-white px-4 py-2 rounded hover:bg-gray-800" %>
</div>

<div class="bg-white rounded-lg shadow-sm border divide-y">
  <% @events.each do |event| %>
    <%= link_to event, class: "block p-4 hover:bg-gray-50" do %>
      <div class="flex justify-between items-center">
        <div>
          <div class="font-medium"><%= event.title %></div>
          <div class="text-sm text-gray-500">
            <%= event.starts_at.strftime("%b %d, %Y %I:%M %p") %>
            <% if event.is_multi_day? %>
              <span class="ml-2 text-xs bg-blue-100 text-blue-700 px-2 py-0.5 rounded">Multi-day</span>
            <% end %>
          </div>
        </div>
        <div class="text-sm text-gray-400"><%= event.event_shifts.count %> shift(s)</div>
      </div>
    <% end %>
  <% end %>
</div>

<% if @events.empty? %>
  <div class="p-6 text-gray-500 text-center bg-white rounded-lg border">No events yet.</div>
<% end %>
